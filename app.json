{
  "expo": {
    "name": "Amigo Oculto Já",
    "slug": "amigo-oculto-ja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "amigoocultoja",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.amigoocultoja.app",
      "associatedDomains": [
        "applinks:amigoocultoja.com.br"
      ]
    },
    "android": {
      "package": "br.com.amigoocultoja.app",
      "adaptiveIcon": {
        "backgroundColor": "#111418",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "amigoocultoja.com.br",
              "pathPrefix": "/g"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Amigo Oculto Já — Amigo oculto sem papelzinho",
      "shortName": "Amigo Oculto Já",
      "lang": "pt-BR",
      "themeColor": "#111418",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

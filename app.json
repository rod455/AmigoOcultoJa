{
  "expo": {
    "name": "Amigo Oculto Já!",
    "slug": "amigo-oculto-ja",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "amigoocultoja",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.amigoocultoja.app",
      "associatedDomains": [
        "applinks:amigoocultoja.com.br",
        "webcredentials:amigoocultoja.com.br"
      ],
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": [
          "pt-BR"
        ]
      }
    },
    "android": {
      "package": "br.com.amigoocultoja.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6E3DC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "amigoocultoja.com.br",
              "pathPrefix": "/g"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Amigo Oculto Já!",
      "shortName": "Amigo Oculto Já!",
      "lang": "pt-BR",
      "themeColor": "#C63D24",
      "backgroundColor": "#FFFFFF",
      "description": "A surpresa fica. A complicação sai."
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://amigoocultoja.com.br"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6E3DC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
